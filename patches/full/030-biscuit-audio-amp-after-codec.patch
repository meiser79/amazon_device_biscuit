@@ -467,13 +472,23 @@
 static ssize_t out_write(struct audio_stream_out* stream, const void* buffer,
                          size_t bytes) {
     struct wrapper_stream_out* out = wrap_out(stream);
+    ssize_t ret;
 
     if (!out->active) {
         apply_speaker_route();
-        set_speaker_amp(true);
         out->active = true;
     }
